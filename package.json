{
  "name": "@jiesou/dsh-stream-rules",
  "version": "0.1.7",
  "description": "Inject rules when needed, without wasting context. DSH port of opencode-stream-rules.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "rules",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "release": "npm run build && npm version patch && git push --follow-tags && npm publish"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "rules",
    "guardrail",
    "just-in-time",
    "stream-rules"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiesou/dsh-stream-rules.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
